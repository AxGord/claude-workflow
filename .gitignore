node_modules
build/
.DS_Store
.playwright-mcp/

# Override global gitignore for Claude plugin files
!CLAUDE.md
!.mcp.json
docs/.vitepress/cache/
docs/.vitepress/dist/
video/.venv/
video/cache/
video/out/
video/voice-sample.*

# generated by `npm run docs:workflows` (docs:build, the test run); never committed
docs/public/workflows.json

# The engine's own slice workflow is a tracked file (the global `**/.claude/` ignore hid it from every worktree);
# the rest of .claude/ stays local.
!/.claude/
/.claude/*
!/.claude/workflows/
/.claude/workflows/*
!/.claude/workflows/engine-task.yaml
!/.claude/workflows/pool-gate.yaml
